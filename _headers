# HTTP-Kopfzeilen fuer Cloudflare Pages.
# GitHub Pages kann keine Kopfzeilen setzen - diese Datei wird dort ignoriert
# und wirkt erst nach dem Umzug.

/*
  # Nur ueber HTTPS, auch fuer Unterdomains. Zwei Jahre, wie fuer die
  # Preload-Liste vorausgesetzt.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Kein Erraten von Dateitypen - schuetzt vor untergeschobenen Inhalten.
  X-Content-Type-Options: nosniff
  # Die Seite darf nicht in fremde Rahmen eingebettet werden (Clickjacking).
  X-Frame-Options: DENY
  # Beim Wechsel auf fremde Seiten nur die Herkunftsdomain uebermitteln,
  # nicht den vollstaendigen Pfad.
  Referrer-Policy: strict-origin-when-cross-origin
  # Funktionen, die diese Seite nicht braucht, gar nicht erst zulassen.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # Inhaltsrichtlinie: eigene Quellen, dazu die Backend-Schnittstelle fuer
  # Rechner und Kontaktformular. Inline-Stile und -Skripte erzeugt Astro
  # selbst, deshalb 'unsafe-inline'.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://intern.nanofassadendaemmung.de; font-src 'self'; object-src 'none'

# Gebaute Dateien tragen einen Inhalts-Hash im Namen - sie aendern sich nie
# unter derselben Adresse und duerfen daher dauerhaft zwischengespeichert
# werden.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder, Logos und Icons aendern sich selten; ein Tag Cache mit
# Nachfrist, damit ein Austausch trotzdem zeitnah ankommt.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/tarife/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/shop/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
